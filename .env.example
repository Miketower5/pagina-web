# PostgreSQL
POSTGRES_DB=gestor_gastos
POSTGRES_USER=gestor
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://gestor:changeme@db:5432/gestor_gastos

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# App
SECRET_KEY=changeme-use-openssl-rand-hex-32
DEBUG=false
ALLOWED_ORIGINS=["http://localhost:3000"]

# Encryption (pgp_sym_encrypt key)
PGP_SYM_KEY=changeme-use-a-strong-passphrase

# Mercado Pago
MP_WEBHOOK_SECRET=
MP_ACCESS_TOKEN=

# Belvo SDK
BELVO_SECRET_ID=
BELVO_SECRET_PASSWORD=
BELVO_ENV=sandbox

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
