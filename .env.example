# PostgreSQL
POSTGRES_DB=gestor_gastos
POSTGRES_USER=gestor
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://gestor:changeme@db:5432/gestor_gastos

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# App
SECRET_KEY=changeme-use-openssl-rand-hex-32
DEBUG=false
ALLOWED_ORIGINS=["http://localhost:3000"]

# Encryption (pgp_sym_encrypt key)
PGP_SYM_KEY=changeme-use-a-strong-passphrase

# Mercado Pago
MP_WEBHOOK_SECRET=
MP_ACCESS_TOKEN=

# Belvo SDK
BELVO_SECRET_ID=
BELVO_SECRET_PASSWORD=
BELVO_ENV=sandbox

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Video Creation Pipeline ──────────────────────────────────────────────────

# Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-opus-4-6

# Google Cloud — Vertex AI (Imagen 3 + Veo 2)
GOOGLE_PROJECT_ID=your_gcp_project_id
GOOGLE_LOCATION=us-central1
# Also set GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# or run: gcloud auth application-default login

# ElevenLabs
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2

# OpenAI (Whisper)
OPENAI_API_KEY=your_openai_api_key_here

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_ACCESS_TOKEN=your_tiktok_user_access_token

# YouTube Data API v3
YOUTUBE_CLIENT_ID=your_oauth2_client_id
YOUTUBE_CLIENT_SECRET=your_oauth2_client_secret
YOUTUBE_REFRESH_TOKEN=your_oauth2_refresh_token

# Pipeline settings
OUTPUT_DIR=output
SCENES_COUNT=5
CLIP_DURATION=5
